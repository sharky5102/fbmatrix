{
  "description": "Run the full pytest suite when Codex is ready to stop.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/run_pytest_stop.py\"",
            "commandWindows": "powershell.exe -NoProfile -Command \"Set-Location (git rev-parse --show-toplevel); & '.venv\\Scripts\\python.exe' '.codex\\hooks\\run_pytest_stop.py'\"",
            "timeout": 1800,
            "statusMessage": "Running the full pytest suite"
          }
        ]
      }
    ]
  }
}
